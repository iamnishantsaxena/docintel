JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:1.5b
# LLM_MAX_TOKENS=2048       # cap on each model reply
# LLM_API_KEY=...            # for hosted OpenAI-compatible endpoints (Groq, OpenAI, ...)
# Optional cloud model, tried FIRST when CLOUD_LLM_API_KEY is set; the local model above is the fallback.
# Document text is sent to this provider. Set LLM_BASE_URL= (empty) for cloud-only.
# CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_LLM_MODEL=llama-3.1-8b-instant
# CLOUD_LLM_API_KEY=...
# LLM_ENABLED=false          # regex-only mode
# CELERY_EAGER=true          # process inline without Redis/worker (dev only)
